# Copy values from a secret manager into the deployment environment. Do not
# commit a populated production .env file.
TRACEPILOT_IMAGE=ghcr.io/vanquan3008/tracepilot@sha256:replace-with-release-digest
TRACEPILOT_DATABASE_URL=postgres://tracepilot:replace@private-postgres:5432/tracepilot?sslmode=require
TRACEPILOT_AUTH_BOOTSTRAP_API_KEY=replace-with-a-unique-secret-at-least-32-characters
# Directory must contain tls.crt, tls.key and the issuing CA certificate ca.crt.
# The CA is also used to require and verify Syslog client certificates when
# TRACEPILOT_SECURITY_ENABLED=true.
TRACEPILOT_TLS_DIRECTORY=/run/secrets/tracepilot-tls
TRACEPILOT_HEALTHCHECK_SERVER_NAME=tracepilot.example.internal

# Keep the management UI private behind a TLS reverse proxy. OTLP and Syslog
# must be published only on the intended trusted network.
TRACEPILOT_HTTP_PUBLISH=127.0.0.1:8080:8080
# Replace loopback with an explicit private/trusted interface when remote
# senders need direct access. Do not publish these listeners to the internet.
TRACEPILOT_OTLP_GRPC_PUBLISH=127.0.0.1:4317:4317
TRACEPILOT_OTLP_HTTP_PUBLISH=127.0.0.1:4318:4318
TRACEPILOT_SYSLOG_PUBLISH=127.0.0.1:6514:6514
TRACEPILOT_SECURITY_ENABLED=false
TRACEPILOT_SECURITY_SYSLOG_TLS=true
# Keep false unless outbound HTTPS webhooks are required. When true, provide
# a random 32-byte hex or base64 key from the secret manager.
TRACEPILOT_NOTIFICATIONS_ENABLED=false
TRACEPILOT_WEBHOOK_ENCRYPTION_KEY=
TRACEPILOT_HTTP_ALLOWED_ORIGINS=https://tracepilot.example.internal
TRACEPILOT_HTTP_RATE_LIMIT_REQUESTS=120
TRACEPILOT_HTTP_RATE_LIMIT_AUTH_REQUESTS=20
TRACEPILOT_HTTP_RATE_LIMIT_REPLAY_REQUESTS=10
TRACEPILOT_HTTP_RATE_LIMIT_WINDOW=1m
