# Test-only settings for the disposable stack in deploy/test/compose.yaml.
# Every secret here is fake and must never be used outside this harness.
TRACEPILOT_APP_PRODUCTION=false
TRACEPILOT_OBSERVABILITY_LOG_LEVEL=info

TRACEPILOT_DATABASE_URL=postgres://tracepilot:tracepilot-test-only@postgres:5432/tracepilot_e2e?sslmode=disable
TRACEPILOT_DATABASE_MAX_CONNECTIONS=40
TRACEPILOT_DATABASE_AUTO_MIGRATE=false

TRACEPILOT_CLICKHOUSE_URL=http://clickhouse:8123
TRACEPILOT_CLICKHOUSE_DATABASE=tracepilot_e2e
TRACEPILOT_CLICKHOUSE_USERNAME=default
TRACEPILOT_CLICKHOUSE_PASSWORD=
TRACEPILOT_CLICKHOUSE_AUTO_MIGRATE=false
TRACEPILOT_CLICKHOUSE_LOG_PARTITION=weekly

TRACEPILOT_AUTH_JWT_SECRET=test-only-jwt-secret-not-for-production-0000
TRACEPILOT_AUTH_INGEST_JWT_SECRET=test-only-ingest-secret-not-for-production-00
TRACEPILOT_AUTH_ALLOW_REGISTRATION=true
TRACEPILOT_SEED_ADMIN_EMAIL=admin@tracepilot.local
TRACEPILOT_SEED_ADMIN_PASSWORD=admin-password-123

TRACEPILOT_HTTP_ADDRESS=:8080
TRACEPILOT_HTTP_ALLOWED_ORIGINS=http://console:8080
TRACEPILOT_HTTP_METRICS_TOKEN=test-only-metrics-token-not-for-production-00
# Browser tests and the load generator share one client address; raise the limits like CI does.
TRACEPILOT_HTTP_RATE_LIMIT_AUTH_REQUESTS=200
TRACEPILOT_HTTP_RATE_LIMIT_REQUESTS=1000

TRACEPILOT_STORAGE_RETENTION_MAX_AGE=168h

# Eight queue workers, as in the README capacity runs.
TRACEPILOT_QUEUE_WORKERS=8
