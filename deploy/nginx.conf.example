# Install on the Linux host behind a real DNS name and trusted TLS certificate.
# Backend/console ports below are bound only to the host loopback interface.
server {
    listen 80;
    server_name tracepilot.example.com otlp.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name tracepilot.example.com;
    ssl_certificate /etc/letsencrypt/live/tracepilot.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tracepilot.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 60s;
        client_max_body_size 1m;
    }
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
}

server {
    listen 443 ssl;
    server_name otlp.example.com;
    ssl_certificate /etc/letsencrypt/live/otlp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/otlp.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;

    location ~ ^/v1/(traces|logs|metrics)$ {
        proxy_pass http://127.0.0.1:4318;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
