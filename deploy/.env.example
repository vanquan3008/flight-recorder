# Development defaults for deploy/compose.dev.yaml. Copy to deploy/.env only when overriding.
POSTGRES_DB=tracepilot
POSTGRES_USER=tracepilot
POSTGRES_PASSWORD=tracepilot-dev-only
TRACEPILOT_DATABASE_URL=postgres://tracepilot:tracepilot-dev-only@postgres:5432/tracepilot?sslmode=disable
TRACEPILOT_HTTP_ADDRESS=:8080
TRACEPILOT_LOG_LEVEL=info
# Bounded process-local management API limits (per client IP and window).
# TRACEPILOT_HTTP_RATE_LIMIT_REQUESTS=120
# TRACEPILOT_HTTP_RATE_LIMIT_AUTH_REQUESTS=20
# TRACEPILOT_HTTP_RATE_LIMIT_REPLAY_REQUESTS=10
# TRACEPILOT_HTTP_RATE_LIMIT_WINDOW=1m

# Development-only Syslog receiver. Production requires TLS when enabled.
# TRACEPILOT_SECURITY_ENABLED=true
# TRACEPILOT_SECURITY_SYSLOG_ADDRESS=:6514
# TRACEPILOT_SECURITY_SYSLOG_CLIENT_CA_FILE=
# TRACEPILOT_NOTIFICATIONS_ENABLED=false
# TRACEPILOT_WEBHOOK_ENCRYPTION_KEY=
# TRACEPILOT_SECURITY_SYSLOG_TLS=false
# TRACEPILOT_SECURITY_DETECTION_INTERVAL=5s

# Development-only key for the local Compose quickstart. Replace it if the
# stack is reachable by anyone else; production always requires a secret.
TRACEPILOT_AUTH_BOOTSTRAP_API_KEY=tracepilot-development-bootstrap-key-000000
