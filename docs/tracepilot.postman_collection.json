              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceMetrics\": [\n    {\n      \"resource\": {\n        \"attributes\": [\n          {\n            \"key\": \"service.name\",\n            \"value\": {\n              \"stringValue\": \"postman-demo\"\n            }\n          }\n        ]\n      },\n      \"scopeMetrics\": [\n        {\n          \"scope\": {\n            \"name\": \"postman\"\n          },\n          \"metrics\": [\n            {\n              \"name\": \"postman.queue.depth\",\n              \"unit\": \"1\",\n              \"gauge\": {\n                \"dataPoints\": [\n                  {\n                    \"timeUnixNano\": \"{{endNs}}\",\n                    \"asInt\": \"7\",\n                    \"attributes\": [\n                      {\n                        \"key\": \"queue\",\n                        \"value\": {\n                          \"stringValue\": \"orders\"\n                        }\n                      }\n                    ]\n                  }\n                ]\n              }\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
