              }
            ],
            "url": {
              "raw": "{{otlpUrl}}/v1/logs",
              "host": [
                "{{otlpUrl}}"
              ],
              "path": [
                "v1",
                "logs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Accepted keys are never cached, so revocation applies to the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ],
      "description": "Negative cases. Keep the last two requests in this order: they revoke the key created in folder 2."
    }
