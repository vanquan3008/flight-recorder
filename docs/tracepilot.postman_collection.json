                "v1",
                "logs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceLogs\": [\n    {\n      \"resource\": {\n        \"attributes\": [\n          {\n            \"key\": \"service.name\",\n            \"value\": {\n              \"stringValue\": \"postman-demo\"\n            }\n          }\n        ]\n      },\n      \"scopeLogs\": [\n        {\n          \"scope\": {\n            \"name\": \"postman\"\n          },\n          \"logRecords\": [\n            {\n              \"timeUnixNano\": \"{{endNs}}\",\n              \"severityNumber\": 17,\n              \"severityText\": \"ERROR\",\n              \"body\": {\n                \"stringValue\": \"postman-{{runId}} payment failed for order 42\"\n              },\n              \"traceId\": \"{{traceId}}\",\n              \"spanId\": \"{{spanId}}\",\n              \"attributes\": [\n                {\n                  \"key\": \"order.id\",\n                  \"value\": {\n                    \"stringValue\": \"42\"\n                  }\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('nothing rejected', function () { const b = pm.response.json(); pm.expect(b.partialSuccess || {}).to.not.have.any.keys('rejectedSpans', 'rejectedLogRecords', 'rejectedDataPoints'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Logs: free-text secrets (must be masked)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{ingestKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{otlpUrl}}/v1/logs",
              "host": [
                "{{otlpUrl}}"
              ],
              "path": [
                "v1",
                "logs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceLogs\": [\n    {\n      \"resource\": {\n        \"attributes\": [\n          {\n            \"key\": \"service.name\",\n            \"value\": {\n              \"stringValue\": \"postman-demo\"\n            }\n          }\n        ]\n      },\n      \"scopeLogs\": [\n        {\n          \"scope\": {\n            \"name\": \"postman\"\n          },\n          \"logRecords\": [\n            {\n              \"timeUnixNano\": \"{{endNs}}\",\n              \"severityNumber\": 17,\n              \"severityText\": \"ERROR\",\n              \"body\": {\n                \"stringValue\": \"postman-{{runId}} login failed password=hunter2 Authorization: Bearer abcdefgh12345678 db=postgres://app:p4ssw0rd@db.internal/x\"\n              },\n              \"attributes\": [\n                {\n                  \"key\": \"exception.message\",\n                  \"value\": {\n                    \"stringValue\": \"session token=abcdef123456 expired\"\n                  }\n                },\n                {\n                  \"key\": \"http.url\",\n                  \"value\": {\n                    \"stringValue\": \"https://app.test/reset?token=abc123&user=7\"\n                  }\n                },\n                {\n                  \"key\": \"http.request.header.authorization\",\n                  \"value\": {\n                    \"stringValue\": \"Bearer should-be-masked-by-key-name\"\n                  }\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Body, exception.message and a URL carry credentials. Check them with 'Logs: secrets were masked' in folder 4."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('nothing rejected', function () { const b = pm.response.json(); pm.expect(b.partialSuccess || {}).to.not.have.any.keys('rejectedSpans', 'rejectedLogRecords', 'rejectedDataPoints'); });"
