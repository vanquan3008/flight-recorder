              "raw": "{{bigBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "5 MiB, above the default 4 MiB ingestion.max_request_bytes."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('bigBody', '{\"pad\":\"' + 'x'.repeat(5 * 1024 * 1024) + '\"}');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 413', function () { pm.response.to.have.status(413); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Bad key, repeat 65x (Collection Runner) -> 401 then 429",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "junk-{{$randomUUID}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{otlpUrl}}/v1/logs",
              "host": [
                "{{otlpUrl}}"
              ],
              "path": [
                "v1",
                "logs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run only this request, 65 iterations, no delay. After 60 failures from one address OTLP answers 429 without touching the database. WARNING: the whole address is blocked for the next minute, valid keys included. Wait one minute before the other folders."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected, then throttled', function () { pm.expect([401, 429]).to.include(pm.response.code); });",
                  "if (pm.response.code === 429) { pm.test('Retry-After is set', function () { pm.expect(pm.response.headers.get('Retry-After')).to.be.ok; }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke the ingest key -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
