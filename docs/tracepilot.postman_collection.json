                  "value": "{{fromIso}}"
                },
                {
                  "key": "to",
                  "value": "{{toIso}}"
                }
              ]
            },
            "description": "Fails if any of the credentials sent by 'Logs: free-text secrets' is stored. Needs ScrubFreeText enabled (the default)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const text = pm.response.text();",
                  "pm.test('no credential reaches storage', function () {",
                  "  ['hunter2', 'abcdefgh12345678', 'p4ssw0rd', 'abcdef123456', 'abc123', 'should-be-masked'].forEach(function (secret) {",
                  "    pm.expect(text, secret).to.not.include(secret);",
                  "  });",
                  "});",
                  "pm.test('masking is visible', function () { pm.expect(text).to.include('[REDACTED]'); });"
                ]
              }
            }
          ]
