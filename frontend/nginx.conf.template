# Render bởi envsubst lúc khởi động: chỉ ${TRACEPILOT_API_UPSTREAM} được thay.
# Giá trị là scheme://host:port, không kèm đường dẫn.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Header bảo mật khai báo một lần ở cấp server. Các location bên dưới chỉ dùng
    # expires, không dùng add_header, để không làm mất các header này.
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; connect-src 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${TRACEPILOT_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Backend trả 504 sau TRACEPILOT_HTTP_REQUEST_TIMEOUT (20s); nginx phải chờ lâu hơn.
        proxy_read_timeout 30s;
    }

    # Tên file có hash nên cache lâu; file thiếu phải 404, không rơi về index.html.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    # Fallback SPA. index.html không cache để bản mới có hiệu lực ngay.
    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
