# Rendered by envsubst at startup; only ${TRACEPILOT_API_UPSTREAM} is substituted.
# Use scheme://host:port without a path.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Define security headers at server scope. Locations use expires instead of
    # add_header so they inherit these headers.
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; connect-src 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${TRACEPILOT_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Wait longer than the backend's TRACEPILOT_HTTP_REQUEST_TIMEOUT (20s).
        proxy_read_timeout 30s;
    }

    # Cache hashed assets; missing files must return 404 instead of index.html.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    # SPA fallback. Do not cache index.html so new releases take effect immediately.
    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
