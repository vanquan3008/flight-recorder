# Biến của console (frontend). Tách khỏi .env ở root, file đó chỉ chứa cấu hình backend.
# Sao chép thành frontend/.env (không commit) nếu cần.

# ---- Lúc build (Vite đọc file này; với Docker dùng --build-arg) ----
# Để trống khi nginx của image console proxy /api về backend (cùng origin).
# Chỉ đặt khi console host riêng, ví dụ https://api.example.internal. Khi đó thêm
# origin của console vào TRACEPILOT_HTTP_ALLOWED_ORIGINS của backend.
VITE_API_BASE_URL=

# ---- Lúc chạy image console (docker run --env-file frontend/.env hoặc -e) ----
# Vite không đọc biến này. Địa chỉ backend nginx proxy tới, không kèm đường dẫn.
# Host phải phân giải được khi nginx khởi động.
TRACEPILOT_API_UPSTREAM=http://tracepilot:8080

# ---- Playwright e2e: đặt trong shell, không đọc từ file này ----
# TRACEPILOT_E2E_EMAIL / TRACEPILOT_E2E_PASSWORD  tài khoản test; mặc định là admin do seed.sql tạo, tài khoản khác sẽ tự đăng ký
# TRACEPILOT_E2E_BASE_URL     mặc định http://127.0.0.1:4173
