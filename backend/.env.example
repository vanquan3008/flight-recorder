

# ---- Bắt buộc ----
# Kết nối tới PostgreSQL của dịch vụ khác. Production dùng sslmode=verify-full.
TRACEPILOT_DATABASE_URL=postgres://tracepilot:CHANGE-ME@localhost:5432/tracepilot?sslmode=disable
# Khóa ký JWT (phiên đăng nhập và ingest token), tối thiểu 32 ký tự. Bắt buộc và phải đổi khi chạy production.
# Để trống thì mỗi lần chạy sinh khóa ngẫu nhiên: đăng nhập và token cũ hết hiệu lực khi khởi động lại.
TRACEPILOT_AUTH_JWT_SECRET=tracepilot-development-jwt-secret-000000000000
# Cho phép ai cũng đăng ký tài khoản. Tài khoản đầu tiên luôn được phép và thành super admin.
TRACEPILOT_AUTH_ALLOW_REGISTRATION=true

# ---- Chạy ----
# true khi chạy thật: bắt buộc TLS và không cho dùng khóa hay mật khẩu mẫu.
TRACEPILOT_PRODUCTION=false
TRACEPILOT_LOG_LEVEL=info
# Cổng API quản trị. Giao diện (console) là ứng dụng riêng, xem frontend/.env.example.
TRACEPILOT_HTTP_ADDRESS=:8080
# Token cho bộ thu thập Prometheus đọc /metrics khi production (tối thiểu 32 ký tự, gửi qua Authorization: Bearer).
# Để trống thì chỉ super admin đã đăng nhập đọc được.
TRACEPILOT_HTTP_METRICS_TOKEN=
# Trang web được phép gọi API từ trình duyệt.
TRACEPILOT_HTTP_ALLOWED_ORIGINS=http://localhost:5173
# Địa chỉ reverse proxy đứng trước TracePilot, để trống nếu không có.
TRACEPILOT_HTTP_TRUSTED_PROXIES=

# ---- Thời gian lưu dữ liệu (0s là giữ mãi) ----
# Trace, log, metric: 7 ngày.
TRACEPILOT_RETENTION_MAX_AGE=168h
# Sự cố đã đóng: 90 ngày.
TRACEPILOT_RETENTION_INCIDENT_MAX_AGE=2160h
# Lịch sử thay đổi truy cập (tài khoản, project, thành viên, ingest token): 180 ngày.
TRACEPILOT_RETENTION_AUDIT_MAX_AGE=4320h
# Webhook đã gửi xong: 30 ngày.
TRACEPILOT_RETENTION_DELIVERY_MAX_AGE=720h

# ---- Giới hạn (mặc định thường đủ dùng) ----
# Gửi sai khóa quá số lần này trong 1 phút thì bị chặn tạm. 0 là tắt.
TRACEPILOT_INGESTION_AUTH_FAILURE_LIMIT=60
TRACEPILOT_INGESTION_AUTH_FAILURE_WINDOW=1m
# Che mật khẩu, token nằm trong nội dung log.
TRACEPILOT_INGESTION_SCRUB_FREE_TEXT=true
# Bộ nhớ tối đa cho hàng đợi nhận dữ liệu, tính bằng byte (64 MiB).
TRACEPILOT_INGESTION_QUEUE_MAX_BYTES=67108864
# Số truy vấn API chạy cùng lúc và thời gian tối đa của mỗi truy vấn.
TRACEPILOT_HTTP_MAX_CONCURRENT_QUERIES=4
TRACEPILOT_HTTP_REQUEST_TIMEOUT=20s
# Giới hạn phía PostgreSQL. STATEMENT_TIMEOUT không được nhỏ hơn REQUEST_TIMEOUT.
TRACEPILOT_DATABASE_STATEMENT_TIMEOUT=30s
TRACEPILOT_DATABASE_LOCK_TIMEOUT=10s
TRACEPILOT_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=30s

# ---- Webhook (tùy chọn) ----
TRACEPILOT_NOTIFICATIONS_ENABLED=false
# Khóa 32 byte (hex hoặc base64) để mã hóa secret của webhook.
TRACEPILOT_WEBHOOK_ENCRYPTION_KEY=
