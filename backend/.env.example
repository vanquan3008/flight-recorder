# App - Production mode enables strict security checks; TLS files must be set together.
TRACEPILOT_APP_PRODUCTION=false
TRACEPILOT_APP_SHUTDOWN_TIMEOUT=15s
TRACEPILOT_APP_TLS_CERTIFICATE_FILE=
TRACEPILOT_APP_TLS_PRIVATE_KEY_FILE=

# HTTP - API listener, CORS, proxies, request limits and rate limits. Set METRICS_TOKEN in production.
TRACEPILOT_HTTP_METRICS_TOKEN=
TRACEPILOT_HTTP_ADDRESS=:8080
TRACEPILOT_HTTP_ALLOWED_ORIGINS=http://localhost:5173
TRACEPILOT_HTTP_TRUSTED_PROXIES=
TRACEPILOT_HTTP_MAX_CONCURRENT_QUERIES=4
TRACEPILOT_HTTP_MAX_CONCURRENT_LOG_QUERIES=8
TRACEPILOT_HTTP_REQUEST_TIMEOUT=20s
TRACEPILOT_HTTP_READ_HEADER_TIMEOUT=5s
TRACEPILOT_HTTP_READ_TIMEOUT=15s
TRACEPILOT_HTTP_WRITE_TIMEOUT=30s
TRACEPILOT_HTTP_IDLE_TIMEOUT=1m
TRACEPILOT_HTTP_MAX_HEADER_BYTES=1048576
TRACEPILOT_HTTP_MANAGEMENT_MAX_BODY_BYTES=1048576
TRACEPILOT_HTTP_RATE_LIMIT_REQUESTS=120
TRACEPILOT_HTTP_RATE_LIMIT_WINDOW=1m
TRACEPILOT_HTTP_RATE_LIMIT_AUTH_REQUESTS=20
TRACEPILOT_HTTP_RATE_LIMIT_REPLAY_REQUESTS=10

# Database - PostgreSQL (required). Reserve at least 2 x TRACEPILOT_QUEUE_WORKERS + 2 connections.
TRACEPILOT_DATABASE_URL=postgres://tracepilot:<DB_PASSWORD>@localhost:5432/tracepilot?sslmode=disable
TRACEPILOT_DATABASE_AUTO_MIGRATE=false
TRACEPILOT_DATABASE_MAX_CONNECTIONS=20
TRACEPILOT_DATABASE_MIN_CONNECTIONS=2
TRACEPILOT_DATABASE_CONNECT_TIMEOUT=5s
TRACEPILOT_DATABASE_MAX_CONNECTION_LIFETIME=1h
TRACEPILOT_DATABASE_MAX_CONNECTION_IDLE_TIME=30m
TRACEPILOT_DATABASE_HEALTH_CHECK_PERIOD=1m
TRACEPILOT_DATABASE_READINESS_TIMEOUT=2s
TRACEPILOT_DATABASE_STATEMENT_TIMEOUT=30s
TRACEPILOT_DATABASE_LOCK_TIMEOUT=10s
TRACEPILOT_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=30s
TRACEPILOT_DATABASE_MIGRATION_LOCK_TIMEOUT=10s
TRACEPILOT_DATABASE_MIGRATION_STATEMENT_TIMEOUT=5m
TRACEPILOT_DATABASE_PARTITION_WINDOW_DAYS=10
TRACEPILOT_DATABASE_PARTITION_CHECK_INTERVAL=1h

# ClickHouse - Telemetry store (required). LOG_PARTITION: daily, weekly, monthly or yearly.
TRACEPILOT_CLICKHOUSE_URL=http://localhost:8123
TRACEPILOT_CLICKHOUSE_AUTO_MIGRATE=false
TRACEPILOT_CLICKHOUSE_DATABASE=tracepilot
TRACEPILOT_CLICKHOUSE_USERNAME=default
TRACEPILOT_CLICKHOUSE_PASSWORD=
TRACEPILOT_CLICKHOUSE_REQUEST_TIMEOUT=10s
TRACEPILOT_CLICKHOUSE_MAX_CONNECTIONS=8
TRACEPILOT_CLICKHOUSE_LOG_PARTITION=weekly

# Auth - JWT secrets of at least 32 characters; in production both are required and must differ.
TRACEPILOT_AUTH_JWT_SECRET=<GENERATE_RANDOM_SECRET_MIN_32_CHARS>
TRACEPILOT_AUTH_INGEST_JWT_SECRET=
TRACEPILOT_AUTH_ALLOW_REGISTRATION=true
TRACEPILOT_AUTH_ACCESS_TOKEN_TTL=15m
TRACEPILOT_AUTH_REFRESH_TOKEN_TTL=720h
TRACEPILOT_AUTH_COOKIE_DOMAIN=
TRACEPILOT_AUTH_COOKIE_SAME_SITE=strict
TRACEPILOT_AUTH_ISSUER=tracepilot
TRACEPILOT_AUTH_AUDIENCE=tracepilot

# Cache - DRIVER: auto, redis, memory or noop. auto uses Redis when URL or ADDRESS is set.
TRACEPILOT_CACHE_DRIVER=auto
TRACEPILOT_CACHE_URL=
TRACEPILOT_CACHE_ADDRESS=
TRACEPILOT_CACHE_PASSWORD=
TRACEPILOT_CACHE_DB=0
TRACEPILOT_CACHE_DEFAULT_TTL=1m
TRACEPILOT_CACHE_DEFAULT_LIMIT=4096
TRACEPILOT_CACHE_TOKEN_TTL=30s
TRACEPILOT_CACHE_TOKEN_LIMIT=4096
TRACEPILOT_CACHE_SCOPE_TTL=30s
TRACEPILOT_CACHE_SCOPE_LIMIT=1024
TRACEPILOT_CACHE_IDENTITY_TTL=30s
TRACEPILOT_CACHE_IDENTITY_LIMIT=4096

# Storage - Retention ages; 0s keeps data indefinitely. Projects can override the telemetry age.
TRACEPILOT_STORAGE_RETENTION_MAX_AGE=168h
TRACEPILOT_STORAGE_RETENTION_INCIDENT_MAX_AGE=2160h
TRACEPILOT_STORAGE_RETENTION_AUDIT_MAX_AGE=4320h
TRACEPILOT_STORAGE_RETENTION_DELIVERY_MAX_AGE=720h
TRACEPILOT_STORAGE_RETENTION_CHECK_INTERVAL=1h
TRACEPILOT_STORAGE_RETENTION_BATCH_SIZE=10000

# Queue - Bounded queue and batching shared by the event and metric pipelines.
TRACEPILOT_QUEUE_QUEUE_SIZE=4096
TRACEPILOT_QUEUE_QUEUE_MAX_BYTES=67108864
TRACEPILOT_QUEUE_ENQUEUE_TIMEOUT=250ms
TRACEPILOT_QUEUE_BATCH_SIZE=256
TRACEPILOT_QUEUE_BATCH_TIMEOUT=5s
TRACEPILOT_QUEUE_FLUSH_INTERVAL=200ms
TRACEPILOT_QUEUE_WORKERS=2

# Ingestion - OTLP listeners, default scope, payload limits, redaction and auth throttling.
TRACEPILOT_INGESTION_GRPC_ADDRESS=:4317
TRACEPILOT_INGESTION_HTTP_ADDRESS=:4318
TRACEPILOT_INGESTION_PROJECT_ID=01900000-0000-7000-8000-000000000001
TRACEPILOT_INGESTION_PROJECT_SLUG=default
TRACEPILOT_INGESTION_PROJECT_NAME=Default Project
TRACEPILOT_INGESTION_ENVIRONMENT_ID=01900000-0000-7000-8000-000000000002
TRACEPILOT_INGESTION_ENVIRONMENT_NAME=development
TRACEPILOT_INGESTION_MAX_REQUEST_BYTES=4194304
TRACEPILOT_INGESTION_MAX_RECORDS_PER_REQUEST=10000
TRACEPILOT_INGESTION_MAX_CONCURRENT_REQUESTS=32
TRACEPILOT_INGESTION_MAX_ATTRIBUTES_PER_RECORD=128
TRACEPILOT_INGESTION_MAX_ATTRIBUTE_VALUE_BYTES=4096
TRACEPILOT_INGESTION_MAX_ATTRIBUTE_DEPTH=4
TRACEPILOT_INGESTION_REDACTED_KEYS=
TRACEPILOT_INGESTION_AUTH_FAILURE_LIMIT=60
TRACEPILOT_INGESTION_AUTH_FAILURE_WINDOW=1m
TRACEPILOT_INGESTION_SCRUB_FREE_TEXT=true

# Observability - LOG_LEVEL: debug, info, warn or error. LOG_FORMAT: json or text.
TRACEPILOT_OBSERVABILITY_LOG_LEVEL=info
TRACEPILOT_OBSERVABILITY_LOG_FORMAT=

# Replay - Disabled by default; ALLOWED_HOSTS is required when enabled.
TRACEPILOT_REPLAY_ENABLED=false
TRACEPILOT_REPLAY_ALLOWED_HOSTS=
TRACEPILOT_REPLAY_ALLOW_PRIVATE=false
TRACEPILOT_REPLAY_TIMEOUT=5s
TRACEPILOT_REPLAY_MAX_REQUEST_BYTES=65536
TRACEPILOT_REPLAY_MAX_RESPONSE_BYTES=65536
TRACEPILOT_REPLAY_MAX_CONCURRENT=2

# Notifications - Webhook delivery; ENCRYPTION_KEY is required when enabled.
TRACEPILOT_NOTIFICATIONS_ENABLED=false
TRACEPILOT_NOTIFICATIONS_ENCRYPTION_KEY=
TRACEPILOT_NOTIFICATIONS_POLL_INTERVAL=5s
TRACEPILOT_NOTIFICATIONS_WORKERS=4
TRACEPILOT_NOTIFICATIONS_REQUEST_TIMEOUT=10s

# Seed - Development administrator for tracepilot seed. Disabled in production.
TRACEPILOT_SEED_ADMIN_EMAIL=admin@tracepilot.local
TRACEPILOT_SEED_ADMIN_PASSWORD=admin-password-123
TRACEPILOT_SEED_ADMIN_NAME=Admin
