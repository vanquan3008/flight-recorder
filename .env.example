# Development only. Use a secret manager and TLS-terminated endpoints in production.
TRACEPILOT_PRODUCTION=false
POSTGRES_PASSWORD=replace-with-a-strong-password
# The database name/user remain stable during the TracePilot migration.
TRACEPILOT_DATABASE_URL=postgres://flight:replace-with-a-strong-password@postgres:5432/flight?sslmode=disable
# Set this only when migrating a volume created under a different Compose project name.
# TRACEPILOT_POSTGRES_VOLUME_NAME=existing-project_flight-postgres
TRACEPILOT_AUTH_BOOTSTRAP_API_KEY=replace-with-a-random-secret-at-least-32-characters
# The agent reads this from its process environment; do not put it in command-line arguments.
# TRACEPILOT_AGENT_API_KEY=replace-with-agent-key-at-least-32-characters
# Required when TRACEPILOT_PRODUCTION=true.
# TRACEPILOT_TLS_CERTIFICATE_FILE=/run/secrets/tracepilot.crt
# TRACEPILOT_TLS_PRIVATE_KEY_FILE=/run/secrets/tracepilot.key

# Redaction is case-insensitive and supplements TracePilot's built-in sensitive-key matching.
TRACEPILOT_INGESTION_REDACTED_KEYS=customer.email,customer.phone

# Set a real retention policy before production use, for example 30 days.
TRACEPILOT_RETENTION_MAX_AGE=720h
