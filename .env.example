# The only env template. Copy to repository-root .env; never commit .env.
# Compose injects .env through env_file. Native Go also reads this root file
# (go -C backend falls back to ../.env). Process env overrides native file values.

# Local Compose. Clear COMPOSE_PROFILES when using an external production DB.
COMPOSE_PROFILES=local
POSTGRES_DB=tracepilot
POSTGRES_USER=tracepilot
POSTGRES_PASSWORD=tracepilot-dev-only
# Inside Compose the DB host is postgres; native Go uses localhost instead.
TRACEPILOT_DATABASE_URL=postgres://tracepilot:tracepilot-dev-only@postgres:5432/tracepilot?sslmode=disable
TRACEPILOT_AUTH_BOOTSTRAP_API_KEY=tracepilot-development-bootstrap-key-000000
TRACEPILOT_PRODUCTION=false
TRACEPILOT_HTTP_ADDRESS=:8080
TRACEPILOT_LOG_LEVEL=info

# Default host bindings are loopback. Change only to a trusted interface.
TRACEPILOT_HTTP_PUBLISH=127.0.0.1:8080:8080
TRACEPILOT_OTLP_GRPC_PUBLISH=127.0.0.1:4317:4317
TRACEPILOT_OTLP_HTTP_PUBLISH=127.0.0.1:4318:4318
TRACEPILOT_POSTGRES_PUBLISH=127.0.0.1:5432:5432
TRACEPILOT_HTTP_ALLOWED_ORIGINS=http://localhost:5173

TRACEPILOT_NOTIFICATIONS_ENABLED=false
TRACEPILOT_WEBHOOK_ENCRYPTION_KEY=
# 0s disables deletion. Choose a retention policy before production.
TRACEPILOT_RETENTION_MAX_AGE=0s
# Budget per pipeline, not total RSS.
TRACEPILOT_INGESTION_QUEUE_MAX_BYTES=67108864

# Production: edit the SAME .env, clear COMPOSE_PROFILES, set PRODUCTION=true,
# replace the bootstrap key and DB URL, and set the following values.
# The DB URL must use verify-full with a trusted CA and matching hostname.
# TRACEPILOT_IMAGE=ghcr.io/vanquan3008/tracepilot@sha256:<release-digest>
# TRACEPILOT_TLS_DIRECTORY=/run/secrets/tracepilot-tls
# TRACEPILOT_TLS_CERTIFICATE_FILE=/run/tracepilot/tls/tls.crt
# TRACEPILOT_TLS_PRIVATE_KEY_FILE=/run/tracepilot/tls/tls.key
# TRACEPILOT_HEALTHCHECK_CA_FILE=/run/tracepilot/tls/ca.crt
# TRACEPILOT_HEALTHCHECK_SERVER_NAME=tracepilot.example.internal
# TRACEPILOT_HTTP_ALLOWED_ORIGINS=https://tracepilot.example.internal
# Optional private database CA: place postgres-ca.crt in TLS_DIRECTORY and add
# &sslrootcert=/run/tracepilot/tls/postgres-ca.crt to TRACEPILOT_DATABASE_URL.
# Other fields map to TRACEPILOT_<SECTION>_<FIELD>, e.g.:
# TRACEPILOT_HTTP_RATE_LIMIT_REQUESTS=120
# TRACEPILOT_HTTP_RATE_LIMIT_AUTH_REQUESTS=20
# TRACEPILOT_HTTP_RATE_LIMIT_REPLAY_REQUESTS=10
# TRACEPILOT_HTTP_RATE_LIMIT_WINDOW=1m
